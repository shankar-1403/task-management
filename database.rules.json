{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "usersByEmail": {
      "$emailKey": {
        ".read": "auth != null",
        ".write": "auth != null && newData.val() === auth.uid"
      }
    },
    "pendingInvites": {
      "$emailKey": {
        ".read": "auth != null && root.child('users').child(auth.uid).child('emailKey').val() === $emailKey",
        "$projectId": {
          ".read": "auth != null && root.child('users').child(auth.uid).child('emailKey').val() === $emailKey",
          ".write": "auth != null && (root.child('userProjects').child(auth.uid).child($projectId).val() === true || root.child('users').child(auth.uid).child('emailKey').val() === $emailKey)"
        }
      }
    },
    "notifications": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        "$notifId": {
          ".write": "auth != null && (auth.uid == $uid || (!data.exists() && newData.child('fromUserId').val() === auth.uid && newData.child('toUserId').val() === $uid && (newData.child('type').val() === 'task_assigned' || newData.child('type').val() === 'task_priority')))"
        }
      }
    },
    "myTasksLayout": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "userProjects": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        "$projectId": {
          ".write": "auth != null && (auth.uid == $uid || root.child('userProjects').child(auth.uid).child($projectId).val() === true)"
        }
      }
    },
    "projects": {
      "$projectId": {
        ".read": "auth != null && root.child('userProjects').child(auth.uid).child($projectId).val() === true",
        ".write": "auth != null && (!data.exists() ? newData.child('ownerId').val() === auth.uid : root.child('userProjects').child(auth.uid).child($projectId).val() === true)",
        "memberIds": {
          "$memberUid": {
            ".write": "auth != null && root.child('userProjects').child(auth.uid).child($projectId).val() === true"
          }
        },
        "sections": {
          "$sectionId": {
            ".read": "auth != null && root.child('userProjects').child(auth.uid).child($projectId).val() === true",
            ".write": "auth != null && root.child('userProjects').child(auth.uid).child($projectId).val() === true"
          }
        },
        "tasks": {
          "$taskId": {
            ".read": "auth != null && root.child('userProjects').child(auth.uid).child($projectId).val() === true",
            ".write": "auth != null && root.child('userProjects').child(auth.uid).child($projectId).val() === true"
          }
        }
      }
    }
  }
}

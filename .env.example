VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_DATABASE_URL=https://your_project_id-default-rtdb.firebaseio.com

# EmailJS — invite emails from the browser (hosting-only, no Cloud Functions)
# Free: 200 emails/month. Paid plans for more: https://www.emailjs.com/pricing
# 1. Sign up at https://www.emailjs.com
# 2. Email Services → Add Gmail → connect your account
# 3. Email Templates → create template with variables:
#    {{to_email}}, {{to_name}}, {{from_name}}, {{project_name}}, {{app_url}}, {{message}}
#    Set "To" field to: {{to_email}}
# 4. Account → Public Key
VITE_EMAILJS_SERVICE_ID=service_xxxxxxx
VITE_EMAILJS_TEMPLATE_ID=template_xxxxxxx
VITE_EMAILJS_PUBLIC_KEY=your_public_key

# App URL in invite links (optional — uses current site URL if empty)
VITE_APP_URL=https://your-project.web.app
